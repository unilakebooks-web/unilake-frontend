# ============================================================
# UniLake frontend — environment variables
# ============================================================
# Copy to `.env.local` and fill in. All are public (NEXT_PUBLIC_*): they are
# inlined into the browser bundle at build time, so never put a secret here.
# Changing one requires a rebuild / dev-server restart.

# Origin of the backend API (REST, auth and WebSocket all share it).
# No trailing slash. Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_AUTH_URL=http://localhost:8080

# Public origin of THIS site — used for canonical URLs, the sitemap and
# social share cards. Defaults to https://www.unilakekids.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
